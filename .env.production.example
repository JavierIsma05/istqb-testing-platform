# Copy to .env.production and replace every placeholder before deployment.
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=replace-with-a-long-random-production-secret
DEBUG=False
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

DB_NAME=istqb_db
DB_USER=istqb_app
DB_PASSWORD=replace-with-a-unique-database-password
DB_HOST=db
DB_PORT=5432
PGCLIENTENCODING=UTF8

AUTOMATION_ALLOWED_HOSTS=localhost,127.0.0.1,::1
WEB_PORT=8000
GUNICORN_BIND=0.0.0.0:8000
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
